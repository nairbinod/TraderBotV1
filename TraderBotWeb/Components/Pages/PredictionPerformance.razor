@page "/performance"
@attribute [StreamRendering]
@using TraderBotWeb.Services

<HeadContent>
    <title>Prediction Performance Analysis - TraderBot</title>
    <meta name="description" content="Analyze the historical performance of AI trading predictions and calculate hypothetical returns." />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-EZHRLZHN4T"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-EZHRLZHN4T');
    </script>
</HeadContent>

<main class="container py-4 py-md-5">
    <!-- Page Header -->
    <header class="row align-items-center mb-4">
        <div class="col-12">
            <span class="badge bg-primary-subtle text-primary mb-3">
                <i class="fas fa-chart-bar me-2"></i>Performance Analysis
            </span>
            <h1 class="display-5 fw-bold mb-3">Prediction Performance</h1>
            <p class="lead text-muted">
                Analyze historical prediction accuracy and calculate hypothetical returns.
            </p>
        </div>
    </header>

    <!-- Section 1: Date Range Filter -->
    <section class="card mb-4">
        <div class="card-body">
            <h2 class="h5 mb-3"><i class="fas fa-calendar-alt me-2"></i>Select Analysis Period</h2>
            <div class="d-flex flex-column flex-md-row gap-3 align-items-end flex-wrap">
                <div class="d-flex gap-2 align-items-center">
                    <label class="mb-0 small text-muted">From</label>
                    <InputDate @bind-Value="dateFrom" class="form-control form-control-sm" style="width: 150px;" />
                </div>
                <div class="d-flex gap-2 align-items-center">
                    <label class="mb-0 small text-muted">To</label>
                    <InputDate @bind-Value="dateTo" class="form-control form-control-sm" style="width: 150px;" />
                </div>
                <div class="btn-group btn-group-sm">
                    <button class="btn btn-outline-secondary" @onclick="() => SetDateRange(5)">5 Days</button>
                    <button class="btn btn-outline-secondary" @onclick="() => SetDateRange(14)">14 Days</button>
                    <button class="btn btn-outline-secondary" @onclick="() => SetDateRange(20)">20 Days</button>
                </div>
                <button class="btn btn-primary" @onclick="LoadPerformanceData" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    }
                    else
                    {
                        <i class="fas fa-search me-1"></i>
                    }
                    Analyze
                </button>
            </div>
        </div>
    </section>

    <!-- Section 2: Performance Metrics Summary Cards -->
    @if (isDataLoaded && predictions.Count > 0)
    {
        <section class="row g-4 mb-4">
            <!-- Win Rate Card -->
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center">
                        <i class="fas fa-trophy text-warning fs-2 mb-2"></i>
                        <h3 class="h2 fw-bold @(winRate >= 0.5m ? "text-success" : "text-danger")">
                            @winRate.ToString("P1")
                        </h3>
                        <p class="text-muted mb-0">Win Rate</p>
                        <small class="text-muted">@winningCount W / @losingCount L</small>
                    </div>
                </div>
            </div>
            <!-- Average Gain/Loss Card -->
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center">
                        <i class="fas fa-percent text-primary fs-2 mb-2"></i>
                        <h3 class="h2 fw-bold @GetPerformanceClass(avgGainLossPercent)">
                            @FormatPercent(avgGainLossPercent)
                        </h3>
                        <p class="text-muted mb-0">Avg. Return per Trade</p>
                    </div>
                </div>
            </div>
            <!-- Best Performer Card -->
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center">
                        <i class="fas fa-arrow-trend-up text-success fs-2 mb-2"></i>
                        <h3 class="h2 fw-bold text-success">@FormatPercent(bestPerformingPercent)</h3>
                        <p class="text-muted mb-0">Best Performer</p>
                        <small class="text-muted">@bestPerformingSymbol</small>
                    </div>
                </div>
            </div>
            <!-- Worst Performer Card -->
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center">
                        <i class="fas fa-arrow-trend-down text-danger fs-2 mb-2"></i>
                        <h3 class="h2 fw-bold text-danger">@FormatPercent(worstPerformingPercent)</h3>
                        <p class="text-muted mb-0">Worst Performer</p>
                        <small class="text-muted">@worstPerformingSymbol</small>
                    </div>
                </div>
            </div>
        </section>
    }

    <!-- Section 3: What-If Calculator -->
    <section class="card mb-4">
        <div class="card-body">
            <h2 class="h5 mb-3"><i class="fas fa-calculator me-2"></i>What-If Investment Calculator</h2>
            <p class="text-muted small mb-3">
                See what your returns would be if you had invested a specific amount following all predictions in this period.
            </p>
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-4">
                    <label class="form-label">Investment Amount ($)</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <InputNumber @bind-Value="investmentAmount" class="form-control" min="100" max="1000000" step="100" />
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label">Allocation Strategy</label>
                    <InputSelect @bind-Value="allocationStrategy" class="form-select">
                        <option value="equal">Equal split across all trades</option>
                        <option value="weighted">Weighted by confidence</option>
                    </InputSelect>
                </div>
                <div class="col-12 col-md-4">
                    <button class="btn btn-success w-100" @onclick="CalculateWhatIf" disabled="@(!isDataLoaded || predictions.Count == 0)">
                        <i class="fas fa-calculator me-1"></i> Calculate Returns
                    </button>
                </div>
            </div>

            @if (whatIfResult != null)
            {
                <div class="row mt-4 g-3">
                    <div class="col-12 col-md-4">
                        <div class="p-3 bg-light rounded text-center">
                            <small class="text-muted d-block">Initial Investment</small>
                            <span class="h4 fw-bold">@whatIfResult.InitialInvestment.ToString("C")</span>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="p-3 bg-light rounded text-center">
                            <small class="text-muted d-block">Final Portfolio Value</small>
                            <span class="h4 fw-bold @GetPerformanceClass(whatIfResult.TotalGainLoss)">
                                @whatIfResult.FinalValue.ToString("C")
                            </span>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="p-3 @(whatIfResult.TotalGainLoss >= 0 ? "bg-success-subtle" : "bg-danger-subtle") rounded text-center">
                            <small class="text-muted d-block">Total Return</small>
                            <span class="h4 fw-bold @GetPerformanceClass(whatIfResult.TotalGainLoss)">
                                @FormatCurrency(whatIfResult.TotalGainLoss) (@FormatPercent(whatIfResult.TotalReturnPercent))
                            </span>
                        </div>
                    </div>
                </div>

                <!-- What-If Trade Details -->
                @if (showWhatIfDetails && whatIfResult.TradeDetails.Count > 0)
                {
                    <div class="mt-4">
                        <h6 class="mb-3">Trade-by-Trade Breakdown</h6>
                        <div class="table-responsive" style="max-height: 300px; overflow: auto;">
                            <table class="table table-sm table-hover align-middle">
                                <thead class="table-light position-sticky top-0">
                                    <tr>
                                        <th>Symbol</th>
                                        <th>Date</th>
                                        <th>Invested</th>
                                        <th>Shares</th>
                                        <th>Current Value</th>
                                        <th>Gain/Loss</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var t in whatIfResult.TradeDetails)
                                    {
                                        <tr class="@(t.GainLoss >= 0 ? "table-success" : "table-danger")">
                                            <td class="fw-semibold">@t.Symbol</td>
                                            <td>@t.BarDate.ToString("yyyy-MM-dd")</td>
                                            <td>@t.InvestmentAmount.ToString("C")</td>
                                            <td>@t.SharesPurchased.ToString("F2")</td>
                                            <td>@t.CurrentValue.ToString("C")</td>
                                            <td class="@GetPerformanceClass(t.GainLoss)">
                                                @FormatCurrency(t.GainLoss) (@FormatPercent(t.GainLossPercent))
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                <div class="mt-3">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => showWhatIfDetails = !showWhatIfDetails">
                        <i class="fas @(showWhatIfDetails ? "fa-chevron-up" : "fa-chevron-down") me-1"></i>
                        @(showWhatIfDetails ? "Hide" : "Show") Trade Details
                    </button>
                </div>
            }
        </div>
    </section>

    <!-- Section 4: Detailed Predictions Table -->
    @if (isDataLoaded)
    {
        <section class="card">
            <div class="card-body">
                <h2 class="h5 mb-3">
                    <i class="fas fa-list me-2"></i>Prediction Details
                    <span class="badge bg-secondary ms-2">@predictions.Count trades</span>
                </h2>
                @if (predictions.Count == 0)
                {
                    <div class="alert alert-info mb-0">
                        <i class="fas fa-info-circle me-2"></i>No predictions found for the selected date range.
                    </div>
                }
                else
                {
                    <div class="table-responsive" style="max-height: 500px; overflow: auto;">
                        <table class="table table-sm table-hover align-middle">
                            <thead class="table-light position-sticky top-0">
                                <tr>
                                    <th>Symbol</th>
                                    <th>Date</th>
                                    <th>Entry Price</th>
                                    <th>Current Price</th>
                                    <th>Gain/Loss</th>
                                    <th>Return %</th>
                                    <th>Confidence</th>
                                    <th>Quality</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in predictions)
                                {
                                    var rowClass = p.IsWinner ? "table-success" : "table-danger";
                                    <tr class="@rowClass">
                                        <td class="fw-semibold">
                                            <a href="https://stockanalysis.com/stocks/@p.Symbol.ToLower()/" target="_blank" class="text-decoration-none">
                                                @p.Symbol
                                            </a>
                                        </td>
                                        <td>@p.BarDate.ToString("yyyy-MM-dd")</td>
                                        <td>@p.RecommendedPrice.ToString("C")</td>
                                        <td>@p.CurrentPrice.ToString("C")</td>
                                        <td class="@GetPerformanceClass(p.GainLossAmount)">
                                            @FormatCurrency(p.GainLossAmount)
                                        </td>
                                        <td class="fw-semibold @GetPerformanceClass(p.GainLossPercent)">
                                            @FormatPercent(p.GainLossPercent)
                                        </td>
                                        <td>@p.Confidence.ToString("P0")</td>
                                        <td>@p.Quality.ToString("P0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>
    }

    <!-- Footer disclaimer -->
    <footer class="border-top pt-3 mt-4">
        <div class="text-muted small">
            <i class="fas fa-info-circle me-1"></i>
            Past performance does not guarantee future results. This analysis is for educational purposes only.
        </div>
    </footer>
</main>
